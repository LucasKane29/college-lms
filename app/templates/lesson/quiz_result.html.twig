{% extends 'admin/layout.html.twig' %}
{% block title %}Результат тесту · College LMS{% endblock %}
{% block admin_content %}
    <a href="{{ path('app_lesson_quiz_show', {id: attempt.quiz.id}) }}">← До тесту</a><h1>{{ attempt.testTitle }}</h1>
    <p class="my-4 text-lg font-semibold" data-result>{{ attempt.score }}/{{ attempt.maxScore }} балів · {{ attempt.percent }}%</p>
    <p class="mb-5 text-slate-500">{{ attempt.student.fullName }} · Спроба {{ attempt.number }} · {{ attempt.submittedAt|date('d.m.Y H:i', 'Europe/Kyiv') }}</p>
    {% for response in attempt.responses %}
        <section class="mb-4 rounded-xl border border-slate-200 bg-white p-5">
            <h2>{{ response.question }}</h2><p class="my-2 font-semibold">{{ response.score }}/{{ response.max }} балів</p>
            <p>Ваші відповіді: {{ response.chosen|join('; ') }}</p><p class="mt-2 text-emerald-800">Правильні відповіді: {{ response.correct|join('; ') }}</p>
        </section>
    {% endfor %}
{% endblock %}
