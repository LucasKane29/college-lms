{% extends 'admin/layout.html.twig' %}
{% block title %}{{ quiz.title }} · Тестування{% endblock %}
{% block admin_content %}
    <a href="{{ path('app_lesson_quiz_show', {id: quiz.id}) }}">← До тесту</a><h1>{{ quiz.title }}</h1>
    {% if quiz.description %}<p class="my-4 whitespace-pre-wrap">{{ quiz.description }}</p>{% endif %}
    <div class="mt-6 max-w-3xl rounded-xl border border-slate-200 bg-white p-6">
        {{ form_start(submissionForm) }}{{ form_widget(submissionForm) }}<button class="mt-5 rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700" type="submit">Здати тест</button>{{ form_end(submissionForm) }}
    </div>
{% endblock %}
