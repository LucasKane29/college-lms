<fieldset class="rounded-xl border border-slate-300 bg-slate-50 p-5" data-collection-item>
    {{ form_errors(question) }}{{ form_row(question.text) }}
    <div class="grid gap-4 sm:grid-cols-2">{{ form_row(question.kind) }}{{ form_row(question.points) }}</div>
    {{ form_errors(question.answers) }}
    {% set answerPrototype %}{% include 'lesson/_answer_form.html.twig' with {answer: question.answers.vars.prototype} only %}{% endset %}
    <div data-controller="form-collection" data-form-collection-placeholder-value="__answer__" data-form-collection-index-value="{{ question.answers|length ? max(question.answers|keys) + 1 : 0 }}" data-form-collection-prototype-value="{{ answerPrototype|e('html_attr') }}">
        <div class="space-y-3" data-form-collection-target="list">{% for answer in question.answers %}{% include 'lesson/_answer_form.html.twig' with {answer: answer} only %}{% endfor %}</div>
        <button type="button" class="mt-3 text-sm font-semibold text-blue-700" data-action="form-collection#add">+ Додати відповідь</button>
    </div>
    {% do question.answers.setRendered %}
    <button type="button" class="mt-5 text-sm text-red-700" data-action="form-collection#remove">Прибрати запитання</button>
</fieldset>
