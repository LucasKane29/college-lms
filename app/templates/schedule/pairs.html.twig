{% extends 'schedule/layout.html.twig' %}
{% block title %}Налаштування пар · College LMS{% endblock %}
{% block workspace_content %}
    <div data-ui="schedule-toolbar" class="flex flex-wrap items-end justify-between gap-3 [&_h1]:text-[28px] [&_h1]:font-semibold [&_h1]:tracking-tight"><h1>Налаштування пар</h1><a href="{{ path('app_schedule') }}">← До розкладу</a><a data-ui="schedule-button" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-60" href="{{ path('app_schedule_pair_new') }}" data-turbo-frame="schedule-modal">Додати пару</a></div>
    <p data-ui="schedule-hint" class="my-3.5 text-[13px] leading-relaxed text-slate-500">Будні — понеділок–п’ятниця. Вихідні — субота й неділя. Зміни часу застосовуються до всіх дат розкладу.</p>
    <div data-ui="schedule-panel schedule-table-scroll" class="rounded-2xl border border-slate-200 bg-white p-3.5 min-[761px]:p-6 [&_a:not([data-ui~=schedule-button]):not([data-ui~=schedule-cell]):not([data-ui~=schedule-month-day])]:text-blue-700 overflow-x-auto rounded-xl">
        <table data-ui="schedule-table" class="w-full border-separate border-spacing-0 text-sm [&_th]:border-r [&_th]:border-b [&_td]:border-r [&_td]:border-b [&_th]:border-slate-200 [&_td]:border-slate-200 [&_th]:p-3 [&_td]:p-1 [&_th]:text-left [&_th]:align-top [&_td]:align-top [&_tr>:first-child]:border-l [&_tr>:first-child]:border-slate-200 [&_thead_th]:min-w-40 [&_thead_th]:border-t [&_thead_th]:bg-slate-100 [&_th:first-child]:sticky [&_th:first-child]:left-0 [&_th:first-child]:z-1 [&_th:first-child]:min-w-28 [&_th:first-child]:bg-slate-50 [&_thead_th_span]:mt-1 [&_thead_th_span]:block [&_thead_th_span]:text-xs [&_thead_th_span]:font-normal [&_thead_th_span]:text-slate-500 [&_td]:min-w-[170px]">
            <thead><tr><th scope="col">Номер пари</th><th scope="col">Будні</th><th scope="col">Вихідні</th><th scope="col">Дії</th></tr></thead>
            <tbody>{% for pair in pairs %}<tr data-pair-id="{{ pair.id }}"><th scope="row">{{ pair.number }}</th><td>{{ pair.weekdayStart|date('H:i') }}–{{ pair.weekdayEnd|date('H:i') }}</td><td>{{ pair.weekendStart|date('H:i') }}–{{ pair.weekendEnd|date('H:i') }}</td><td><a href="{{ path('app_schedule_pair_edit', {id: pair.id}) }}" data-turbo-frame="schedule-modal">Редагувати пару {{ pair.number }}</a></td></tr>{% else %}<tr><td colspan="4">Пари ще не додано.</td></tr>{% endfor %}</tbody>
        </table>
    </div>
    <turbo-frame id="schedule-modal"></turbo-frame>
{% endblock %}
