{% extends 'security/layout.html.twig' %}
{% block title %}Вхід · College LMS{% endblock %}

{% block auth_content %}
    <p class="mb-3 text-xs font-semibold tracking-[0.16em] text-blue-600 uppercase">З поверненням</p>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Увійдіть до кабінету</h1>
    <p class="mt-3 text-sm leading-6 text-slate-500">Продовжуйте навчання з того місця, де зупинилися.</p>

    {% if error %}
        <div id="login-error" role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-700">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post" class="mt-8 space-y-5" data-turbo="true">
        <div class="space-y-2">
            <label for="login-email" class="field-label">Електронна пошта</label>
            <input id="login-email" type="email" name="email" value="{{ last_username }}" autocomplete="username" placeholder="name@example.com" maxlength="180" required class="auth-input" {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
        </div>
        <div class="space-y-2" data-controller="password-visibility">
            <label for="login-password" class="field-label">Пароль</label>
            <div class="relative">
                <input id="login-password" type="password" name="password" autocomplete="current-password" required class="auth-input pr-12" data-password-visibility-target="input" {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                {% include 'security/_password_toggle.html.twig' with {input_id: 'login-password'} %}
            </div>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('login') }}">
        <button type="submit" class="primary-button" data-turbo-submits-with="Входимо…">Увійти <span aria-hidden="true">→</span></button>
    </form>

    <p class="mt-8 text-center text-sm text-slate-500">Ще немає облікового запису? <a href="{{ path('app_registration') }}" class="text-link">Зареєструватися</a></p>
{% endblock %}
