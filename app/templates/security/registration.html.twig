{% extends 'security/layout.html.twig' %}
{% block title %}Реєстрація · College LMS{% endblock %}

{% block auth_content %}
    <p class="mb-3 text-xs font-semibold tracking-[0.16em] text-blue-600 uppercase">Новий початок</p>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Створіть свій акаунт</h1>
    <p class="mt-3 text-sm leading-6 text-slate-500">Зробіть перший крок до нових знань.</p>

    {{ form_start(registrationForm, {action: path('app_registration'), attr: {class: 'mt-8 space-y-5', 'data-turbo': 'true'}}) }}
        {% if registrationForm.vars.errors|length %}
            <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">{{ form_errors(registrationForm) }}</div>
        {% endif %}
        {% include 'security/_field.html.twig' with {field: registrationForm.fullName} %}
        {% include 'security/_field.html.twig' with {field: registrationForm.email} %}
        {% include 'security/_field.html.twig' with {field: registrationForm.phoneNumber} %}
        {% include 'security/_field.html.twig' with {field: registrationForm.birthDate} %}
        {% include 'security/_field.html.twig' with {field: registrationForm.plainPassword.first} %}
        {% include 'security/_field.html.twig' with {field: registrationForm.plainPassword.second} %}
        <button type="submit" data-ui="primary-button" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-60 w-full gap-2 rounded-xl py-3.5 shadow-sm" data-turbo-submits-with="Створюємо акаунт…">Створити акаунт <span aria-hidden="true">→</span></button>
    {{ form_end(registrationForm) }}

    <p class="mt-8 text-center text-sm text-slate-500">Уже маєте обліковий запис? <a href="{{ path('app_login') }}" data-ui="text-link" class="font-semibold text-blue-600 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600">Увійти</a></p>
{% endblock %}
