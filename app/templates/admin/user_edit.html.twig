{% extends 'admin/layout.html.twig' %}
{% block title %}Редагування користувача · College LMS{% endblock %}
{% block admin_content %}
    <turbo-frame id="user-edit-modal">
        <dialog open data-ui="user-edit-dialog" class="fixed inset-0 m-auto w-[calc(100vw-2rem)] max-w-[560px] max-h-[calc(100dvh-3rem)] overflow-y-auto rounded-2xl border border-slate-300 bg-white p-5 text-slate-900 shadow-2xl backdrop:bg-slate-900/50 sm:p-7 [&_form>div]:mb-4" data-controller="modal" data-modal-user-id-value="{{ editedUser.id }}" data-action="cancel->modal#cancel click->modal#backdrop turbo:before-cache@document->modal#cancel" aria-labelledby="user-edit-title">
            <div data-ui="user-edit-heading" class="flex items-start justify-between gap-4 [&_h1]:text-2xl">
                <h1 id="user-edit-title">Редагування користувача</h1>
                <button type="button" data-ui="user-edit-close" class="size-11 shrink-0 rounded-lg text-[28px] hover:bg-slate-100" data-action="modal#cancel" aria-label="Закрити">×</button>
            </div>
            <p data-ui="admin-description" class="mt-2 mb-6 text-slate-500">{{ editedUser.fullName }} · ID {{ editedUser.id }}</p>
            {{ form_start(editForm) }}
                {% if editForm.vars.errors|length %}<div role="alert">{{ form_errors(editForm) }}</div>{% endif %}
                {% for field in editForm %}
                    {% if field.vars.name != '_token' %}
                        {% include 'security/_field.html.twig' with {field: field} %}
                    {% endif %}
                {% endfor %}
                <div data-ui="user-edit-actions" class="mt-6 flex flex-wrap items-center gap-5">
                    <button type="submit" data-ui="admin-button" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-60" data-turbo-submits-with="Зберігаємо…">Зберегти зміни</button>
                    <a href="{{ path('app_admin_users', catalog) }}" data-action="modal#cancel" data-turbo-frame="_top">Скасувати</a>
                </div>
            {{ form_end(editForm) }}
        </dialog>
    </turbo-frame>
{% endblock %}
