{% extends 'admin/layout.html.twig' %}
{% block title %}{{ group.name }} · College LMS{% endblock %}
{% block admin_content %}
    <a href="{{ path('app_curator_groups') }}">← Групи</a>
    <h1>{{ group.name }}</h1>
    <p data-ui="admin-description" class="mt-2 mb-6 text-slate-500">Куратор: {{ group.curator.fullName }} · Студентів: {{ total }}</p>
    <p data-ui="admin-description" class="mt-2 mb-6 text-slate-500"><a href="{{ path('app_curator_students', {withoutGroup: 1}) }}">Додати студентів до групи</a></p>
    <div data-ui="admin-table-scroll" class="overflow-x-auto rounded-xl border border-slate-200 bg-white" role="region" aria-label="Студенти групи" tabindex="0">
        <table data-ui="admin-table" class="w-full border-collapse text-left text-sm [&_th]:whitespace-nowrap [&_th]:bg-slate-100 [&_th]:font-semibold [&_th]:p-4 [&_td]:p-4 [&_th]:border-b [&_td]:border-b [&_th]:border-slate-200 [&_td]:border-slate-200 [&_th]:align-top [&_td]:align-top [&_td]:min-w-[110px] [&_td]:wrap-anywhere [&_td:last-child]:whitespace-nowrap [&_tr:last-child_td]:border-b-0 [&_tbody_tr:hover]:bg-slate-50">
            <thead><tr><th scope="col">Ім’я та прізвище</th><th scope="col">Email</th><th scope="col">Дії</th></tr></thead>
            <tbody>
                {% for student in users %}
                    <tr data-student-id="{{ student.id }}"><td>{{ student.fullName }}</td><td>{{ student.email }}</td><td>
                        <form action="{{ path('app_curator_student_remove', {id: group.id, studentId: student.id}) }}" method="post">
                            <input type="hidden" name="_token" value="{{ csrf_token('remove_student_' ~ group.id ~ '_' ~ student.id) }}">
                            <button type="submit" data-ui="admin-remove" class="min-h-11 text-red-700 hover:text-red-800" aria-label="Вилучити {{ student.fullName }} з групи">Вилучити з групи</button>
                        </form>
                    </td></tr>
                {% else %}<tr><td colspan="3" data-ui="admin-empty" class="px-4! py-12! text-center text-slate-500">У групі ще немає студентів.</td></tr>{% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'curator/_pagination.html.twig' with {route: 'app_curator_group_show', query: {id: group.id}} %}
{% endblock %}
