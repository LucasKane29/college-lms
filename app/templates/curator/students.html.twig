{% extends 'admin/layout.html.twig' %}
{% block title %}Студенти · College LMS{% endblock %}
{% block admin_content %}
    <h1>Усі студенти</h1>
    <p data-ui="admin-description" class="mt-2 mb-6 text-slate-500">Додавайте студентів без групи до власних груп.</p>
    <section data-ui="admin-panel" class="rounded-xl border border-slate-200 bg-white p-5 [&_h2]:mb-4 [&_h2]:text-base [&_h2]:font-semibold" aria-label="Фільтри студентів">
        {{ form_start(filterForm, {attr: {class: 'grid grid-cols-1 gap-4 min-[541px]:grid-cols-2 min-[1001px]:grid-cols-4'}}) }}
            {{ form_errors(filterForm) }}
            {% for field in filterForm %}<div data-ui="admin-field" class="mb-3">{{ form_row(field) }}</div>{% endfor %}
            <div data-ui="admin-filter-actions" class="col-span-full flex flex-wrap items-center gap-4"><button data-ui="admin-button" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-60" type="submit">Застосувати</button><a href="{{ path('app_curator_students') }}">Скинути фільтри</a></div>
        {{ form_end(filterForm) }}
    </section>
    {% if validFilters %}
        <p data-ui="admin-summary" class="mt-6 mb-3 text-sm text-slate-600">Знайдено студентів: {{ total }}</p>
        <div data-ui="admin-table-scroll" class="overflow-x-auto rounded-xl border border-slate-200 bg-white" role="region" aria-label="Список студентів" tabindex="0">
            <table data-ui="admin-table" class="w-full border-collapse text-left text-sm [&_th]:whitespace-nowrap [&_th]:bg-slate-100 [&_th]:font-semibold [&_th]:p-4 [&_td]:p-4 [&_th]:border-b [&_td]:border-b [&_th]:border-slate-200 [&_td]:border-slate-200 [&_th]:align-top [&_td]:align-top [&_td]:min-w-[110px] [&_td]:wrap-anywhere [&_td:last-child]:whitespace-nowrap [&_tr:last-child_td]:border-b-0 [&_tbody_tr:hover]:bg-slate-50">
                <thead><tr><th scope="col">ID</th><th scope="col">Ім’я та прізвище</th><th scope="col">Email</th><th scope="col">Група</th><th scope="col">Дії</th></tr></thead>
                <tbody>
                    {% for student in users %}
                        <tr data-student-id="{{ student.id }}"><td>{{ student.id }}</td><td>{{ student.fullName }}</td><td>{{ student.email }}</td>
                            <td>{{ student.studentGroup ? student.studentGroup.name : 'Без групи' }}</td>
                            <td>{% if not student.studentGroup %}<a href="{{ path('app_curator_student_assign', {id: student.id}) }}">Додати до групи<span class="sr-only">: {{ student.fullName }}</span></a>{% endif %}</td>
                        </tr>
                    {% else %}<tr><td colspan="5" data-ui="admin-empty" class="px-4! py-12! text-center text-slate-500">Студентів не знайдено.</td></tr>{% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'curator/_pagination.html.twig' with {route: 'app_curator_students'} %}
    {% endif %}
{% endblock %}
