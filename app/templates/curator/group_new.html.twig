{% extends 'admin/layout.html.twig' %}
{% block title %}Створення групи · College LMS{% endblock %}
{% block admin_content %}
    <div data-ui="workspace-card" class="max-w-[640px] rounded-2xl border border-slate-200 bg-white p-5 sm:p-7 [&_h1]:text-[28px] [&_h1]:font-semibold [&_h1]:tracking-tight [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-slate-500 [&_p]:wrap-anywhere">
        <a href="{{ path('app_curator_groups') }}">← Групи</a>
        <h1>Створення групи</h1>
        {{ form_start(groupForm) }}
            {{ form_errors(groupForm) }}
            <div data-ui="admin-field" class="mb-3">{{ form_row(groupForm.name) }}</div>
            <button type="submit" data-ui="admin-button" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-60">Створити групу</button>
        {{ form_end(groupForm) }}
    </div>
{% endblock %}
