{% extends 'admin/layout.html.twig' %}
{% block title %}Групи · College LMS{% endblock %}
{% block admin_content %}
    <h1>{{ is_granted('ROLE_ADMIN') ? 'Усі групи' : 'Мої групи' }}</h1>
    <p data-ui="admin-description" class="mt-2 mb-6 text-slate-500">Груп: {{ total }}</p>
    <p data-ui="admin-description" class="mt-2 mb-6 text-slate-500"><a data-ui="admin-button" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-60" href="{{ path('app_curator_group_new') }}">Створити групу</a></p>
    <div data-ui="admin-table-scroll" class="overflow-x-auto rounded-xl border border-slate-200 bg-white" role="region" aria-label="Групи" tabindex="0">
        <table data-ui="admin-table" class="w-full border-collapse text-left text-sm [&_th]:whitespace-nowrap [&_th]:bg-slate-100 [&_th]:font-semibold [&_th]:p-4 [&_td]:p-4 [&_th]:border-b [&_td]:border-b [&_th]:border-slate-200 [&_td]:border-slate-200 [&_th]:align-top [&_td]:align-top [&_td]:min-w-[110px] [&_td]:wrap-anywhere [&_td:last-child]:whitespace-nowrap [&_tr:last-child_td]:border-b-0 [&_tbody_tr:hover]:bg-slate-50">
            <thead><tr><th scope="col">ID</th><th scope="col">Група</th><th scope="col">Куратор</th><th scope="col">Дата створення</th></tr></thead>
            <tbody>
                {% for group in groups %}
                    <tr><td>{{ group.id }}</td><td><a href="{{ path('app_curator_group_show', {id: group.id}) }}">{{ group.name }}</a></td><td>{{ group.curator.fullName }}</td><td>{{ group.createdAt|date('d.m.Y') }}</td></tr>
                {% else %}
                    <tr><td colspan="4" data-ui="admin-empty" class="px-4! py-12! text-center text-slate-500">Груп ще немає. Створіть першу групу.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'curator/_pagination.html.twig' with {route: 'app_curator_groups'} %}
{% endblock %}
