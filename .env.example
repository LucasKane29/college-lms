# Docker Compose environment (/opt/college/.env), separate from app/.env.
# bash docker/init-env.sh fills blank secrets with random 64-character hex values.
COMPOSE_PROJECT_NAME=college-stage
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
APP_UID=1000
APP_GID=1000
TZ=Europe/Kyiv

# Keep the names/user/vhost URL-safe; generated passwords are URL-safe hex.
MYSQL_DATABASE=college
MYSQL_USER=college
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Host port used only with docker-compose.ide.yml (PHPStorm / SQL clients).
MYSQL_PORT=3307
REDIS_PASSWORD=
RABBITMQ_USER=college
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=college

# Nginx: host reverse proxy or SSH tunnel by default.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Admin UI bind addresses remain hardcoded to 127.0.0.1 in Compose.
RABBITMQ_UI_PORT=15672
MAILPIT_UI_PORT=8025
PORTAINER_HTTPS_PORT=9443
